generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AttendanceRecord {
  id          String   @id
  memberId    String
  serviceId   String
  present     Boolean  @default(true)
  tenantId    String
  checkedInAt DateTime @default(now())
  markedBy    String?  @default("SELF")
  Member      Member   @relation(fields: [memberId], references: [id])
  Service     Service  @relation(fields: [serviceId], references: [id])
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([memberId, serviceId])
  @@index([tenantId, serviceId])
  @@index([serviceId, present])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ContactMessage {
  id       String   @id
  name     String
  email    String
  message  String
  sentAt   DateTime @default(now())
  tenantId String
  Tenant   Tenant   @relation(fields: [tenantId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DiscussionQuestion {
  id                 String               @id
  tenantId           String
  sermonId           String
  question           String
  order              Int                  @default(0)
  createdAt          DateTime             @default(now())
  Sermon             Sermon               @relation(fields: [sermonId], references: [id])
  Tenant             Tenant               @relation(fields: [tenantId], references: [id])
  DiscussionResponse DiscussionResponse[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DiscussionResponse {
  id                 String             @id
  tenantId           String
  questionId         String
  memberId           String
  content            String
  createdAt          DateTime           @default(now())
  Member             Member             @relation(fields: [memberId], references: [id])
  DiscussionQuestion DiscussionQuestion @relation(fields: [questionId], references: [id])
  Tenant             Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([questionId, memberId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EmailSubscriber {
  id           String   @id
  tenantId     String
  email        String
  subscribedAt DateTime @default(now())
  Tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EngagementScore {
  id              String   @id
  tenantId        String
  memberId        String   @unique
  score           Int      @default(0)
  attendanceScore Int      @default(0)
  sermonScore     Int      @default(0)
  givingScore     Int      @default(0)
  communityScore  Int      @default(0)
  computedAt      DateTime @default(now())
  Member          Member   @relation(fields: [memberId], references: [id])
  Tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, score])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FollowUpTask {
  id          String    @id
  tenantId    String
  memberId    String
  title       String
  dueDate     DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  Member      Member    @relation(fields: [memberId], references: [id])
  Tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FormSubmission {
  id          String   @id
  tenantId    String
  type        String
  data        Json
  submittedAt DateTime @default(now())
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model GivingRecord {
  id             String    @id
  tenantId       String
  reference      String    @unique
  amount         Int
  currency       String    @default("NGN")
  donorName      String?
  donorEmail     String?
  category       String?
  paystackStatus String
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  Tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, paystackStatus, createdAt])
  @@index([tenantId, category])
  @@index([donorEmail])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ListenProgress {
  id          String   @id
  tenantId    String
  sermonId    String
  memberId    String
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime
  Member      Member   @relation(fields: [memberId], references: [id])
  Sermon      Sermon   @relation(fields: [sermonId], references: [id])
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([sermonId, memberId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Member {
  id                            String                     @id
  tenantId                      String
  profileId                     String                     @unique
  firstName                     String
  lastName                      String
  email                         String?
  phone                         String?
  gender                        String?
  dateOfBirth                   DateTime?
  weddingAnniversary            DateTime?
  instagram                     String?
  facebook                      String?
  twitter                       String?
  linkedin                      String?
  tiktok                        String?
  address                       String?
  joinedAt                      DateTime                   @default(now())
  bio                           String?
  photoUrl                      String?
  status                        MemberStatus               @default(ACTIVE)
  notifyNewSermons              Boolean                    @default(true)
  tags                          String[]
  householdId                   String?
  deactivationRequestedAt       DateTime?
  AttendanceRecord              AttendanceRecord[]
  DiscussionResponse            DiscussionResponse[]
  EngagementScore               EngagementScore?
  FollowUpTask                  FollowUpTask[]
  ListenProgress                ListenProgress[]
  Household                     Household?                 @relation(fields: [householdId], references: [id])
  Profile                       Profile                    @relation(fields: [profileId], references: [id])
  Tenant                        Tenant                     @relation(fields: [tenantId], references: [id])
  PastorNote                    PastorNote[]
  PastoralAlert                 PastoralAlert[]
  SermonBookmark                SermonBookmark[]
  SermonComment                 SermonComment[]
  SermonDirectMessageSent       SermonDirectMessage[]      @relation("SermonDirectMessageSender")
  SermonDirectMessageReceived   SermonDirectMessage[]      @relation("SermonDirectMessageRecipient")
  BirthdayGreetingReceived      BirthdayGreeting[]         @relation("BirthdayGreetingRecipient")
  BirthdayGreetingAuthored      BirthdayGreeting[]         @relation("BirthdayGreetingAuthor")
  SermonNote                    SermonNote[]
  SermonReaction                SermonReaction[]
  UnitMember                    UnitMember[]
  CareAsMember                  CareAssignment[]           @relation("CareMember")
  CareAsLeader                  CareAssignment[]           @relation("CareLeader")
  FollowUpAsSubject             FollowUpEntry[]            @relation("FollowUpSubjectMember")
  FollowUpAsAssignee            FollowUpEntry[]            @relation("FollowUpAssignee")
  FollowUpLogs                  FollowUpContactLog[]       @relation("FollowUpLoggedBy")
  FollowUpSuggestedAsConnection FollowUpConnection[]       @relation("FollowUpConnectionSuggested")
  FollowUpConnectionsIntroduced FollowUpConnection[]       @relation("FollowUpConnectionIntroducedBy")
  CourseEnrollment              CourseEnrollment[]
  CourseCategoryEnrollment      CourseCategoryEnrollment[]
  PrayerRequest                 PrayerRequest[]
  Question                      Question[]
  UnitTaskAssigned              UnitTask[]
  ServiceAssignment             ServiceAssignment[]

  @@index([tenantId, status])
  @@index([tenantId, joinedAt])
  @@index([tenantId, email])
}

/// Care / discipleship assignment: a member shepherded by a leader (also a member).
model CareAssignment {
  id           String               @id
  tenantId     String
  memberId     String
  leaderId     String
  assignedById String?
  note         String?
  status       CareAssignmentStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  Member       Member               @relation("CareMember", fields: [memberId], references: [id])
  Leader       Member               @relation("CareLeader", fields: [leaderId], references: [id])
  Tenant       Tenant               @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, memberId, leaderId])
  @@index([tenantId, leaderId])
}

enum FollowUpStage {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  AWAITING_REVIEW
  CONFIRMED
  REOPENED
}

enum FollowUpSourceType {
  FIRST_TIMER
  ABSENTEE
}

enum FollowUpOutcome {
  BECAME_MEMBER
  RETURNED
  NOT_INTERESTED
  UNREACHABLE
  /// Below: the current outcome taxonomy shown in the "Log Outcome" form.
  REACHABLE
  TRAVEL
  CAME_FOR_VISITING
  HAVE_A_CHURCH
  WANT_TO_BE_MEMBER
}

enum FollowUpContactMethod {
  CALL
  SMS
  WHATSAPP
  VISIT
  OTHER
}

enum FollowUpContactOutcome {
  REACHED
  NO_ANSWER
  VOICEMAIL
  WRONG_NUMBER
  SCHEDULED_VISIT
}

/// Distinguishes a formal contact attempt (CONTACT — has method/outcome) from a
/// lightweight note (QUICK_UPDATE — note only), a connection-introduction record
/// (CONNECTION, auto-written when a suggested match is introduced), and a
/// system-generated timeline entry (SYSTEM). All share the same timeline so
/// nothing a worker leaves behind gets lost in a separate table.
enum FollowUpLogKind {
  CONTACT
  QUICK_UPDATE
  CONNECTION
  SYSTEM
}

enum FollowUpConnectionStatus {
  SUGGESTED
  INTRODUCED
  CONNECTED
  DECLINED
}

enum FollowUpReportSentVia {
  EMAIL
  WHATSAPP
  BOTH
}

/// A Unit's follow-up "Master List" row: a first-timer (Visitor) or absentee
/// (Member) tracked from first contact to confirmed follow-up. See
/// prisma/manual/2026-07-follow-up.sql for the hand-applied migration.
model FollowUpEntry {
  id               String               @id
  tenantId         String
  unitId           String
  sourceType       FollowUpSourceType
  memberId         String? // subject, when sourceType = ABSENTEE
  visitorId        String? // subject, when sourceType = FIRST_TIMER
  addedById        String // Profile.id of the usher/leader who added them
  assigneeId       String? // Member.id of the team member currently assigned
  stage            FollowUpStage        @default(UNASSIGNED)
  goalContacts     Int                  @default(3)
  contactCount     Int                  @default(0)
  lastContactAt    DateTime?
  outcome          FollowUpOutcome?
  reviewNote       String?
  /// Who sent this entry's details up to the Pastor, and when — a leader's
  /// deliberate choice, not an automatic escalation rule. Null until sent.
  sentToPastorById String?
  sentToPastorAt   DateTime?
  /// "Call back later" — hides the entry from the default/Today views until
  /// this passes, without it being contacted or closed.
  snoozedUntil     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  Tenant           Tenant               @relation(fields: [tenantId], references: [id])
  Unit             Unit                 @relation(fields: [unitId], references: [id])
  Member           Member?              @relation("FollowUpSubjectMember", fields: [memberId], references: [id])
  Visitor          Visitor?             @relation(fields: [visitorId], references: [id])
  Assignee         Member?              @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  AddedBy          Profile              @relation("FollowUpAddedBy", fields: [addedById], references: [id])
  SentToPastorBy   Profile?             @relation("FollowUpSentToPastorBy", fields: [sentToPastorById], references: [id])
  Logs             FollowUpContactLog[]
  Connections      FollowUpConnection[]

  @@index([tenantId, unitId])
  @@index([tenantId, stage])
  @@index([assigneeId])
}

/// One entry on a FollowUpEntry's unified activity timeline. A formal contact
/// attempt (kind = CONTACT) requires method + outcome; a QUICK_UPDATE is just a
/// note; CONNECTION rows are auto-written when a suggested match is introduced.
model FollowUpContactLog {
  id                String                  @id
  tenantId          String
  entryId           String
  byId              String // Member.id who logged it
  kind              FollowUpLogKind         @default(CONTACT)
  method            FollowUpContactMethod?
  outcome           FollowUpContactOutcome?
  note              String
  /// Tagged distinctly from a team member's routine check-in — set when this
  /// log records the Pastor's own call, not a worker's contact.
  isPastoralContact Boolean                 @default(false)
  /// Visible only to the author and this entry's unit leader — for anything
  /// not meant for the whole team.
  isPrivate         Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  Entry             FollowUpEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  By                Member                  @relation("FollowUpLoggedBy", fields: [byId], references: [id])
  Tenant            Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([entryId])
  @@index([tenantId])
}

/// A suggested (or acted-on) friend match for a FollowUpEntry's subject —
/// gender/location/age/job overlap with an existing Member or another
/// consenting first-timer. Proven to help retention: someone with 5-10 new
/// friends in their first 6 months is far more likely to stay.
model FollowUpConnection {
  id                String                   @id
  tenantId          String
  entryId           String
  suggestedMemberId String
  matchReason       String
  sharedAttributes  String[]
  status            FollowUpConnectionStatus @default(SUGGESTED)
  introducedById    String? // Member.id who made the introduction
  introducedAt      DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  Tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  Entry             FollowUpEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  SuggestedMember   Member                   @relation("FollowUpConnectionSuggested", fields: [suggestedMemberId], references: [id])
  IntroducedBy      Member?                  @relation("FollowUpConnectionIntroducedBy", fields: [introducedById], references: [id])

  @@unique([entryId, suggestedMemberId])
  @@index([entryId])
  @@index([tenantId])
}

/// A team leader's compiled report of everything their team logged for one
/// service day, sent to the Admin Head and Pastor. Sending it is the close-out
/// action for that service's follow-up work — entryIds records exactly which
/// entries were covered, so anything left out stays visibly open rather than
/// silently rolling over.
model ServiceFollowUpReport {
  id           String                 @id
  tenantId     String
  serviceId    String
  unitId       String
  compiledById String // Profile.id of the leader who compiled/sent it
  summaryText  String
  stats        Json
  sentVia      FollowUpReportSentVia?
  sentAt       DateTime?
  entryIds     String[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @default(now()) @updatedAt
  Tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  Service      Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  Unit         Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  CompiledBy   Profile                @relation("ServiceFollowUpReportCompiledBy", fields: [compiledById], references: [id])

  @@unique([tenantId, serviceId, unitId])
  @@index([tenantId, unitId])
}

/// A device/browser a user has logged in from before. Used to alert on logins
/// from new (previously unseen) devices.
model KnownDevice {
  id          String   @id
  tenantId    String
  userId      String
  fingerprint String
  userAgent   String?
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, fingerprint])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PastorNote {
  id        String   @id
  tenantId  String
  memberId  String
  content   String
  createdAt DateTime @default(now())
  Member    Member   @relation(fields: [memberId], references: [id])
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PastoralAlert {
  id         String    @id
  tenantId   String
  memberId   String
  type       AlertType
  message    String
  isRead     Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  Member     Member    @relation(fields: [memberId], references: [id])
  Tenant     Tenant    @relation(fields: [tenantId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PaystackWebhookLog {
  id          String   @id
  event       String
  reference   String
  payload     Json
  processedAt DateTime @default(now())
  tenantId    String
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, event, reference])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PrayerRequest {
  id          String              @id
  tenantId    String
  name        String?
  email       String?
  phone       String?
  request     String
  isAnonymous Boolean             @default(false)
  submittedAt DateTime            @default(now())
  status      PrayerRequestStatus @default(PENDING)
  /// Set only when a signed-in member submits (optional auth on the public form).
  /// "Anonymous" only hides identity from the free-text name field shown around
  /// the request — admins can always see the linked member, anonymous or not.
  memberId    String?
  /// AI triage (Gemini), populated fire-and-forget right after creation. Plain
  /// text rather than enums: AI output isn't guaranteed to match a fixed set,
  /// and a Postgres enum violation would throw where a stray value should just
  /// display as-is. All four are null until triage completes (or if it fails/
  /// GEMINI_API_KEY is unset) — the admin UI treats null as "not triaged".
  aiCategory  String?
  aiUrgency   String?
  aiRouteTo   String?
  aiSummary   String?
  aiTriagedAt DateTime?
  Tenant      Tenant              @relation(fields: [tenantId], references: [id])
  Member      Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([memberId])
}

enum PrayerRequestStatus {
  PENDING
  PRAYED
}

/// Public "Ask a Question" submissions — same shape and semantics as PrayerRequest
/// (optional auth, anonymous-name-only, admin list/delete), just a different intake.
model Question {
  id          String         @id
  tenantId    String
  name        String?
  email       String?
  phone       String?
  question    String
  isAnonymous Boolean        @default(false)
  submittedAt DateTime       @default(now())
  status      QuestionStatus @default(PENDING)
  memberId    String?
  Tenant      Tenant         @relation(fields: [tenantId], references: [id])
  Member      Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([memberId])
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  id                            String                  @id
  userId                        String                  @unique
  /// DEPRECATED: no longer the source of truth for authorization. Effective roles
  /// are derived from RoleGrant + assignments (UnitLeadAssignment, DepartmentHead,
  /// HeadUsherAssignment). Kept as a frozen pre-migration snapshot; do not read it.
  legacyRole                    Role                    @default(MEMBER)
  tenantId                      String
  createdAt                     DateTime                @default(now())
  Member                        Member?
  Notification                  Notification[]
  RoleAssignment                RoleAssignment[]
  CommunityPost                 CommunityPost[]
  DepartmentHeadOf              DepartmentHead[]        @relation("DepartmentHeadUser")
  DepartmentHeadAssigned        DepartmentHead[]        @relation("DepartmentHeadAssignedBy")
  DepartmentHodOf               DepartmentHod[]         @relation("DepartmentHodUser")
  DepartmentHodAssigned         DepartmentHod[]         @relation("DepartmentHodAssignedBy")
  RoleGrantOf                   RoleGrant[]             @relation("RoleGrantUser")
  RoleGrantGranted              RoleGrant[]             @relation("RoleGrantGrantedBy")
  UnitLeadOf                    UnitLeadAssignment[]    @relation("UnitLeadUser")
  UnitLeadAssigned              UnitLeadAssignment[]    @relation("UnitLeadAssignedBy")
  HeadUsherOf                   HeadUsherAssignment[]   @relation("HeadUsherUser")
  HeadUsherAssigned             HeadUsherAssignment[]   @relation("HeadUsherAssignedBy")
  FollowUpAdded                 FollowUpEntry[]         @relation("FollowUpAddedBy")
  FollowUpSentToPastor          FollowUpEntry[]         @relation("FollowUpSentToPastorBy")
  ServiceFollowUpReportCompiled ServiceFollowUpReport[] @relation("ServiceFollowUpReportCompiledBy")
  ReportSubmitted               Report[]                @relation("ReportSubmittedBy")
  ReportReviewed                Report[]                @relation("ReportReviewedBy")
  ReportComment                 ReportComment[]
  UnitTaskCreated               UnitTask[]
  UnitExpenseCreated            UnitExpense[]
  UnitTaskCommentAuthor         UnitTaskComment[]
  CalendarFeedToken             CalendarFeedToken[]     @relation("CalendarFeedTokenUser")
  PushSubscription              PushSubscription[]      @relation("PushSubscriptionUser")
  NotificationPreference        NotificationPreference? @relation("NotificationPreferenceUser")
}

/// Explicit global granted role (PASTOR, ADMIN, SUPER_ADMIN). History-preserving:
/// revoking sets endedAt. A DB partial unique index enforces one active grant per
/// (user, role). Tenant-scoped in the service layer; RLS deny-all backstop.
model RoleGrant {
  id          String    @id
  tenantId    String
  userId      String // Profile.id of the grantee
  role        Role // PASTOR | ADMIN | SUPER_ADMIN (enforced in the service)
  grantedById String? // Profile.id of the actor
  grantedAt   DateTime  @default(now())
  endedAt     DateTime? // null = active
  Tenant      Tenant    @relation(fields: [tenantId], references: [id])
  User        Profile   @relation("RoleGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  GrantedBy   Profile?  @relation("RoleGrantGrantedBy", fields: [grantedById], references: [id])

  @@index([tenantId])
  @@index([userId])
}

/// History-preserving unit leadership. One active lead per unit (DB partial unique
/// index). UnitMember.isLead is kept as a denormalized pointer synced in the same
/// transaction. Derives the UNIT_LEAD effective role.
model UnitLeadAssignment {
  id           String    @id
  tenantId     String
  unitId       String
  userId       String // Profile.id of the lead
  assignedById String?
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  Tenant       Tenant    @relation(fields: [tenantId], references: [id])
  Unit         Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  User         Profile   @relation("UnitLeadUser", fields: [userId], references: [id], onDelete: Cascade)
  AssignedBy   Profile?  @relation("UnitLeadAssignedBy", fields: [assignedById], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([userId])
}

/// History-preserving head usher assignment (global, unscoped). One active per user.
/// Derives the HEAD_USHER effective role.
model HeadUsherAssignment {
  id           String    @id
  tenantId     String
  userId       String
  assignedById String?
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  Tenant       Tenant    @relation(fields: [tenantId], references: [id])
  User         Profile   @relation("HeadUsherUser", fields: [userId], references: [id], onDelete: Cascade)
  AssignedBy   Profile?  @relation("HeadUsherAssignedBy", fields: [assignedById], references: [id])

  @@index([tenantId])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RoleAssignment {
  id        String   @id
  tenantId  String
  profileId String
  role      Role
  createdAt DateTime @default(now())
  Profile   Profile  @relation(fields: [profileId], references: [id])
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, profileId, role])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Sermon {
  id                  String                @id
  tenantId            String
  title               String
  speaker             String
  date                DateTime
  audioUrl            String?
  videoUrl            String?
  thumbnailUrl        String?
  description         String?
  publishedAt         DateTime?
  createdAt           DateTime              @default(now())
  audioDuration       Int?
  audioKey            String?
  isFeatured          Boolean               @default(false)
  playCount           Int                   @default(0)
  scheduledFor        DateTime?
  scriptureRef        String?
  series              String?
  seriesSlug          String?
  slug                String                @unique
  status              SermonStatus          @default(DRAFT)
  tags                String[]
  transcript          String?
  updatedAt           DateTime
  type                SermonType            @default(SINGLE)
  DiscussionQuestion  DiscussionQuestion[]
  ListenProgress      ListenProgress[]
  Tenant              Tenant                @relation(fields: [tenantId], references: [id])
  SermonBookmark      SermonBookmark[]
  SermonComment       SermonComment[]
  SermonDirectMessage SermonDirectMessage[]
  Episodes            SermonEpisode[]
  SermonNote          SermonNote[]
  SermonReaction      SermonReaction[]
}

