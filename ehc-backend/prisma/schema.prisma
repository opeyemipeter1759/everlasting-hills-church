/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Service {
  id                    String                  @id
  tenantId              String
  name                  String
  scheduledAt           DateTime
  createdAt             DateTime                @default(now())
  serviceType           ServiceType             @default(SUNDAY)
  openAt                DateTime?
  closeAt               DateTime?
  isOpen                Boolean                 @default(false)
  /// Calendar export fields. scheduledAt + durationMinutes give .ics a real DTEND
  /// (there was no end time before). cancelledAt drives STATUS:CANCELLED in the
  /// subscription feed so a cancellation reaches subscribers instead of the event
  /// silently disappearing from their calendar.
  durationMinutes       Int                     @default(120)
  cancelledAt           DateTime?
  cancelReason          String?
  location              String?
  AttendanceRecord      AttendanceRecord[]
  ServiceHeadcount      ServiceHeadcount?
  Assignments           ServiceAssignment[]
  Visitor               Visitor[]
  ServiceFollowUpReport ServiceFollowUpReport[]
  Tenant                Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, scheduledAt])
  @@index([tenantId, serviceType, scheduledAt])
}

/// Per-service serving roster: who is on duty at a given service, and in what
/// capacity. Distinct from the standing-role tables (RoleGrant, UnitLeadAssignment,
/// HeadUsherAssignment, DepartmentHead) which say what someone IS, not what they
/// are rostered for on a specific date. Drives the "serving" marker in the member
/// calendar feed and the 48h serving reminder. Tenant-scoped in the service layer;
/// RLS deny-all backstop via prisma/manual SQL.
model ServiceAssignment {
  id           String   @id
  tenantId     String
  serviceId    String
  memberId     String
  /// Free text capacity, e.g. "Usher", "Media", "Worship". Not an enum: units and
  /// departments are data-driven here, so a fixed enum would go stale.
  role         String
  unitId       String?
  notes        String?
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  Tenant       Tenant   @relation(fields: [tenantId], references: [id])
  Service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  Member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  Unit         Unit?    @relation(fields: [unitId], references: [id])

  @@unique([serviceId, memberId, role])
  @@index([tenantId, serviceId])
  @@index([tenantId, memberId])
}

/// Authoritative usher headcount: one aggregate count per service. Source of
/// truth for congregation size and all growth / attendance-trend analytics.
/// Distinct from AttendanceRecord (per-person check-ins), which stays as-is and
/// powers per-member metrics only. Tenant-scoped in the service layer (@Roles +
/// tenantId); RLS deny-all backstop via prisma/manual SQL.
model ServiceHeadcount {
  id            String          @id
  tenantId      String
  serviceId     String          @unique
  recordedBy    String? // authenticated principal id (no FK; mirrors AuditLog.actorId)
  men           Int             @default(0)
  women         Int             @default(0)
  boys          Int             @default(0)
  girls         Int             @default(0)
  firstTimers   Int             @default(0)
  total         Int             @default(0) // service-computed = men+women+boys+girls; DB CHECK guards it
  reportedTotal Int? // optional usher-reported total, for reconciliation only
  notes         String?
  status        HeadcountStatus @default(DRAFT)
  recordedAt    DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  Service       Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  Tenant        Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

