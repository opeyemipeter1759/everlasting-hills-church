/// Homepage content store. One row per section, content is a typed JSON blob
/// validated server-side by Zod (see src/site-settings/schemas).
model SiteSettings {
  id        String      @id
  tenantId  String
  section   SiteSection
  content   Json
  updatedAt DateTime    @default(now()) @updatedAt
  updatedBy String?
  Tenant    Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, section])
}

// ── Public-site CMS ──────────────────────────────────────────────────────────
// Versioned, draft/publish content for the public website. Tenant-scoped in the
// service layer (@Roles + tenantId filter); RLS added as defense-in-depth via
// prisma/manual SQL. Rich content lives as a portable Tiptap JSON block array in
// ContentVersion.content — no normalized block table (keeps content portable and
// reads single-row). See CMS_ARCHITECTURE.md.

/// One editable public route per tenant. Points at the live published version.
model Page {
  id                 String           @id
  tenantId           String
  key                String // e.g. "home", "about", "about/beliefs", "give"
  title              String
  status             ContentStatus    @default(DRAFT)
  publishedVersionId String? // FK to the ContentVersion the public site reads
  cacheTag           String // ISR revalidation tag, mirrors the public route
  featureFlag        String? // e.g. "blog" — page hidden unless flag enabled
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  updatedBy          String?
  Tenant             Tenant           @relation(fields: [tenantId], references: [id])
  Versions           ContentVersion[] @relation("PageVersions")
  PublishedVersion   ContentVersion?  @relation("PagePublished", fields: [publishedVersionId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

/// Immutable content snapshot. Drafts = newest non-published rows; history =
/// all rows. Rollback republishes any prior version.
model ContentVersion {
  id          String        @id
  tenantId    String
  pageId      String
  version     Int // monotonic per page
  content     Json // Tiptap JSON block array (validated by Zod)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime      @default(now())
  createdBy   String?
  Tenant      Tenant        @relation(fields: [tenantId], references: [id])
  Page        Page          @relation("PageVersions", fields: [pageId], references: [id])
  PublishedOn Page[]        @relation("PagePublished")

  @@unique([pageId, version])
  @@index([tenantId, pageId])
}

/// R2-backed media. Stores the object key (never a public URL); the URL is
/// generated at read time from R2_PUBLIC_URL.
model MediaAsset {
  id         String   @id
  tenantId   String
  r2Key      String
  alt        String // required for accessibility
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// Site-wide settings singleton (one row per tenant): church identity, contact,
/// socials, footer. A form, not blocks — edited live (no draft/publish), audited.
model SiteConfig {
  id        String   @id
  tenantId  String   @unique
  content   Json
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

/// Generic audit trail (create/update/publish/unpublish/delete). Platform-wide,
/// not CMS-only.
model AuditLog {
  id        String   @id
  tenantId  String
  actorId   String?
  action    String // CREATE | UPDATE | PUBLISH | UNPUBLISH | DELETE | ROLLBACK
  entity    String // e.g. "Page", "MediaAsset"
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Unit {
  id                    String                  @id
  tenantId              String
  name                  String
  description           String?
  departmentId          String? // nullable: units can exist unassigned and the UI surfaces them
  createdAt             DateTime                @default(now())
  Tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  Department            Department?             @relation(fields: [departmentId], references: [id])
  UnitMember            UnitMember[]
  LeadAssignments       UnitLeadAssignment[]
  FollowUpEntry         FollowUpEntry[]
  ServiceFollowUpReport ServiceFollowUpReport[]
  Report                Report[]
  UnitPosition          UnitPosition[]
  UnitTask              UnitTask[]
  UnitExpense           UnitExpense[]
  ServiceAssignment     ServiceAssignment[]

  @@index([departmentId])
}

enum ReportScope {
  DEPARTMENT
  UNIT
  PASTOR
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_CORRECTION
}

/// A status report a Unit Lead or Department Head logs about what's going on in
/// their unit/department. Reviewed by a Super Admin on the Audit Log page —
/// approved, or sent back with a correction request (comment).
model Report {
  id             String          @id
  tenantId       String
  scope          ReportScope
  departmentId   String? // set when scope = DEPARTMENT
  unitId         String? // set when scope = UNIT
  submittedById  String // Profile.id of the author
  title          String
  content        String
  attachmentUrl  String? // .docx (or similar) attachment, uploaded via /uploads/document
  attachmentName String? // original filename, for display
  status         ReportStatus    @default(SUBMITTED)
  reviewedById   String? // Profile.id of the Super Admin who last acted on it
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now())
  Tenant         Tenant          @relation(fields: [tenantId], references: [id])
  Department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  Unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  SubmittedBy    Profile         @relation("ReportSubmittedBy", fields: [submittedById], references: [id])
  ReviewedBy     Profile?        @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  Comments       ReportComment[]

  @@index([tenantId, status])
  @@index([departmentId])
  @@index([unitId])
  @@index([submittedById])
}

/// A comment on a Report — visible to both the report's author and reviewers.
/// Flat (no threading): a running log of back-and-forth on one report.
model ReportComment {
  id        String   @id
  tenantId  String
  reportId  String
  authorId  String // Profile.id — either the report's author or a reviewer
  content   String
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
  Report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  Author    Profile  @relation(fields: [authorId], references: [id])

  @@index([reportId])
}

/// A church Administrative Structure (department). Service Units are grouped under
/// departments; each department is led by an Admin Head (see DepartmentHead).
/// Tenant-scoped in the service layer; RLS deny-all backstop via prisma/manual SQL.
model Department {
  id          String           @id
  tenantId    String
  code        String // e.g. OSM, MA, CI, FIN, DATA, WPC, GO
  name        String
  description String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  Tenant      Tenant           @relation(fields: [tenantId], references: [id])
  Units       Unit[]
  Heads       DepartmentHead[]
  Hods        DepartmentHod[]
  Reports     Report[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// History-preserving assignment of a user (Profile) as head of a department.
/// Replacing a head ends the current row (endedAt) and inserts a new one; a DB
/// partial unique index (endedAt IS NULL) enforces one active head per department.
model DepartmentHead {
  id           String     @id
  tenantId     String
  departmentId String
  userId       String // Profile.id of the head
  assignedById String? // Profile.id of the actor who assigned them
  assignedAt   DateTime   @default(now())
  endedAt      DateTime? // null = current head
  Tenant       Tenant     @relation(fields: [tenantId], references: [id])
  Department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  User         Profile    @relation("DepartmentHeadUser", fields: [userId], references: [id], onDelete: Cascade)
  AssignedBy   Profile?   @relation("DepartmentHeadAssignedBy", fields: [assignedById], references: [id])

  @@index([tenantId])
  @@index([departmentId])
  @@index([userId])
}

/// History-preserving assignment of a user (Profile) as an HOD (Head of Department)
/// under a department. Distinct from DepartmentHead: a department may have several
/// active HODs at once, appointed by its Admin Head (or Pastor/Super Admin). An
/// HOD's own capability is appointing Unit Leads within that department's units.
model DepartmentHod {
  id           String     @id
  tenantId     String
  departmentId String
  userId       String // Profile.id of the HOD
  assignedById String? // Profile.id of the actor who assigned them
  assignedAt   DateTime   @default(now())
  endedAt      DateTime? // null = currently active
  Tenant       Tenant     @relation(fields: [tenantId], references: [id])
  Department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  User         Profile    @relation("DepartmentHodUser", fields: [userId], references: [id], onDelete: Cascade)
  AssignedBy   Profile?   @relation("DepartmentHodAssignedBy", fields: [assignedById], references: [id])

  @@index([tenantId])
  @@index([departmentId])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UnitMember {
  id          String        @id
  tenantId    String
  unitId      String
  memberId    String
  isLead      Boolean       @default(false)
  isAssistant Boolean       @default(false)
  positionId  String?
  joinedAt    DateTime      @default(now())
  Member      Member        @relation(fields: [memberId], references: [id])
  Unit        Unit          @relation(fields: [unitId], references: [id])
  Position    UnitPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([unitId, memberId])
  @@index([positionId])
}

/// A custom named title a unit lead can assign members to (e.g. "Secretary",
/// "Treasurer"), independent of the Lead/Assistant flags above.
model UnitPosition {
  id        String       @id
  tenantId  String
  unitId    String
  name      String
  createdAt DateTime     @default(now())
  Tenant    Tenant       @relation(fields: [tenantId], references: [id])
  Unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  Members   UnitMember[]

  @@unique([unitId, name])
  @@index([unitId])
}

enum UnitTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// A task a unit lead assigns to a member of their unit (or leaves unassigned,
/// meaning it applies to the whole unit).
model UnitTask {
  id           String            @id
  tenantId     String
  unitId       String
  title        String
  description  String?
  assignedToId String? // Member.id — null = whole-unit task
  status       UnitTaskStatus    @default(TODO)
  dueDate      DateTime?
  createdById  String // Profile.id
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  Tenant       Tenant            @relation(fields: [tenantId], references: [id])
  Unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  AssignedTo   Member?           @relation(fields: [assignedToId], references: [id])
  CreatedBy    Profile           @relation(fields: [createdById], references: [id])
  Comments     UnitTaskComment[]

  @@index([unitId])
  @@index([assignedToId])
}

/// A comment on a UnitTask — any member of the unit can discuss a task here
/// (e.g. the assignee asking a question, the lead following up).
model UnitTaskComment {
  id        String   @id
  tenantId  String
  taskId    String
  authorId  String // Profile.id
  content   String
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
  Task      UnitTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  Author    Profile  @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

/// A simple expense record a unit lead logs for their unit — no approval
/// workflow, just a running, admin-visible log.
model UnitExpense {
  id          String   @id
  tenantId    String
  unitId      String
  title       String
  amount      Float
  category    String?
  date        DateTime
  description String?
  receiptUrl  String? // uploaded via /uploads/document
  createdById String // Profile.id
  createdAt   DateTime @default(now())
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])
  Unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  CreatedBy   Profile  @relation(fields: [createdById], references: [id])

  @@index([unitId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Visitor {
  id                  String          @id
  tenantId            String
  firstName           String
  lastName            String
  email               String?
  phone               String?
  dateOfBirth         String?
  address             String?
  occupation          String?
  gender              String?
  howDidYouLearn      String?
  invitedBy           String?
  locatedInIbadan     Boolean?
  membershipInterest  String?
  bornAgain           String?
  serviceExperience   String?
  prayerPoint         String?
  whatsappInterest    Boolean?
  /// Consent checkbox on the first-timer form: only when true may this person be
  /// surfaced as a suggested friend-match for someone else (their own reason for
  /// matching them to another guest, not a blanket "may we share your info" flag).
  shareForConnections Boolean         @default(false)
  submittedAt         DateTime        @default(now())
  attendanceType      String?
  convertedAt         DateTime? // set once this visitor becomes a Member; hides them from the first-timers list
  convertedToMemberId String? // no FK; mirrors AuditLog.actorId — just an audit pointer
  serviceId           String? // the Service day this first-timer was registered at, when resolvable
  Tenant              Tenant          @relation(fields: [tenantId], references: [id])
  Service             Service?        @relation(fields: [serviceId], references: [id])
  FollowUpEntry       FollowUpEntry[]

  @@index([tenantId, convertedAt])
  @@index([tenantId, serviceId])
}

/// Online-engagement check-ins (e.g. watching the livestream on YouTube) — tracks
/// an email through FIRST_TIMER -> SECOND_TIMER -> ONLINE_MEMBER stages, distinct
/// from the in-person Visitor first-timer form.
model OnlineCheckIn {
  id             String   @id
  tenantId       String
  email          String
  name           String?
  channel        String
  stage          String   @default("FIRST_TIMER")
  visitCount     Int      @default(1)
  lastCheckedIn  DateTime @default(now())
  supabaseUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email, channel])
  @@index([tenantId, channel, stage])
}

/// Featured "My Everlasting Hills Experience" stories shown on the public homepage slider.
/// Admin/PASTOR curates these — distinct from raw form-submission testimonies (which go
/// through FormSubmission with type='testimony' and are awaiting moderation).
model Testimonial {
  id               String    @id
  tenantId         String
  authorName       String
  authorRole       String? // public-facing byline (e.g. "Member since 2018") — never contact info
  authorPhotoUrl   String?
  content          String
  // Submitter's email/phone from the public testimony form, for the pastoral
  // team's own follow-up only — admin-only, never selected on the public
  // /testimonials/published endpoint. Null for admin-authored testimonials.
  submitterContact String?
  published        Boolean   @default(false)
  publishedAt      DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  Tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, published, order])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Announcement {
  id                 String      @id
  tenantId           String
  title              String
  body               String
  imageUrl           String?
  audience           String      @default("all") // display label only ("all" or "custom"); actual targeting lives in the fields below
  sendEmail          Boolean     @default(false)
  status             EventStatus @default(PUBLISHED)
  createdById        String?
  recipients         Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  // Audience targeting — empty on all three means "everyone" (unchanged default
  // behavior). Otherwise the recipient set is the UNION of: profiles matching any
  // of targetRoles, profiles whose Member.gender is in targetGenders, and the
  // specific profiles in targetProfileIds. targetProfileNames is a display-only
  // snapshot taken at send time so the detail view doesn't need an extra lookup
  // and stays stable even if a person's name changes later.
  targetRoles        Role[]      @default([])
  targetGenders      String[]    @default([])
  targetProfileIds   String[]    @default([])
  targetProfileNames String[]    @default([])
  // Optional event details shown alongside the announcement — a time of day
  // (free text, e.g. "10:00 AM") and a venue/location name.
  eventTime          String?
  venue              String?
  Tenant             Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

/// Reusable, saved email content an admin can send (possibly more than once) to a
/// chosen audience. Distinct from Announcement, which is always a one-shot
/// publish-to-everyone. Sending snapshots subject/body onto EmailSend, so editing
/// a template later doesn't rewrite what was already sent.
model EmailTemplate {
  id          String   @id
  tenantId    String
  name        String
  subject     String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// Audit log of one "send" action — a snapshot of what was sent, to whom (as a
/// resolved audience description), and how many people it reached.
model EmailSend {
  id            String   @id
  tenantId      String
  templateId    String?
  subject       String
  body          String
  audienceMode  String // ALL | UNIT | ROLE | SPECIFIC
  audienceLabel String // human-readable snapshot, e.g. "Unit: Media Team"
  recipients    Int      @default(0)
  sentById      String?
  createdAt     DateTime @default(now())
  Tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Household {
  id        String   @id
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
  Member    Member[]

  @@index([tenantId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Notification {
  id        String    @id
  tenantId  String
  profileId String
  type      String    @default("general")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  Profile   Profile   @relation(fields: [profileId], references: [id])
  Tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([profileId, readAt])
}

/// Per-member secret for the .ics calendar subscription feed. The token IS the
/// auth: calendar clients (Google, Apple, Outlook) cannot send a bearer header,
/// so the URL must be unguessable and revocable. Revoking sets revokedAt rather
/// than deleting, so a regenerated link provably 404s instead of being recycled.
/// A DB partial unique index enforces one active token per user.
/// Tenant-scoped in the service layer; RLS deny-all backstop.
model CalendarFeedToken {
  id             String    @id
  tenantId       String
  userId         String // Profile.id
  token          String    @unique
  createdAt      DateTime  @default(now())
  revokedAt      DateTime? // null = active
  lastAccessedAt DateTime?
  Tenant         Tenant    @relation(fields: [tenantId], references: [id])
  User           Profile   @relation("CalendarFeedTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

/// One row per browser/device push endpoint. endpoint is globally unique (the
/// push service issues it), so re-subscribing the same device upserts rather
/// than duplicating. failedAt/failureCount drive pruning: a 404/410 from the
/// push service deletes the row immediately, transient errors increment.
/// Tenant-scoped in the service layer; RLS deny-all backstop.
model PushSubscription {
  id           String    @id
  tenantId     String
  userId       String // Profile.id
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  failedAt     DateTime?
  failureCount Int       @default(0)
  Tenant       Tenant    @relation(fields: [tenantId], references: [id])
  User         Profile   @relation("PushSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
}

/// Per-member notification categories, quiet hours and timezone. A missing row
/// means "all defaults", so the dispatcher never blocks on a backfill.
///
/// prayerMeeting defaults to false and is opt-in by design: a daily notification
/// is the fastest way to make someone disable notifications altogether.
///
/// quietStart/quietEnd are local wall-clock "HH:MM" read in `timezone`, matching
/// the ATTENDANCE_*_OPEN/CLOSE convention in env config. The window may wrap
/// midnight (22:00 to 06:00); the dispatcher handles that case.
/// Tenant-scoped in the service layer; RLS deny-all backstop.
model NotificationPreference {
  id                String   @id
  tenantId          String
  userId            String   @unique // Profile.id
  serviceStarting   Boolean  @default(true)
  serviceReminder   Boolean  @default(true)
  servingReminder   Boolean  @default(true)
  /// Opt-in only. Never default this to true.
  prayerMeeting     Boolean  @default(false)
  announcements     Boolean  @default(true)
  unitAnnouncements Boolean  @default(true)
  newSermon         Boolean  @default(true)
  milestones        Boolean  @default(true)
  quietStart        String? // "HH:MM", DB CHECK-guarded
  quietEnd          String? // "HH:MM", DB CHECK-guarded
  timezone          String   @default("Africa/Lagos")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  Tenant            Tenant   @relation(fields: [tenantId], references: [id])
  User              Profile  @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Admin-managed recurring online gathering (the daily prayer meeting). Nothing
/// in this schema modelled recurrence before this, so there was no existing
/// recurrence model to extend.
///
/// DTSTART is split on purpose: startDate anchors the RRULE and startTime is
/// local wall-clock "HH:MM" read in `timezone`. A single UTC timestamp would
/// silently shift the meeting whenever the anchor and an occurrence fall on
/// different UTC offsets, which is the classic recurring-event bug.
/// Members read; PASTOR and ADMIN write. RLS deny-all backstop.
model RecurringGathering {
  id              String   @id
  tenantId        String
  title           String
  description     String?
  /// RFC 5545 RRULE, e.g. "FREQ=DAILY". Emitted verbatim into the VEVENT.
  recurrenceRule  String
  startDate       DateTime @db.Date
  startTime       String // "HH:MM" local wall clock, DB CHECK-guarded
  durationMinutes Int      @default(60)
  timezone        String   @default("Africa/Lagos")
  joinUrl         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  Tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
}

