model CommunityPost {
  id        String   @id
  tenantId  String
  profileId String
  text      String   @db.VarChar(500)
  reactions Int      @default(0)
  createdAt DateTime @default(now())
  Profile   Profile  @relation(fields: [profileId], references: [id])
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// Discipleship course catalog, managed at /dashboard/admin/courses. A course can
/// require another course be completed (100% exam score) before it unlocks.
model Course {
  id             String   @id
  tenantId       String
  slug           String
  title          String
  tagline        String
  description    String
  categoryId     String?
  iconKey        String
  gradientFrom   String
  gradientTo     String
  duration       String
  instructorName String
  instructorRole String
  outcomes       String[]
  prerequisiteId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  Tenant        Tenant             @relation(fields: [tenantId], references: [id])
  CategoryRef   CourseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  Prerequisite  Course?            @relation("CoursePrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  UnlocksFor    Course[]           @relation("CoursePrerequisite")
  Modules       CourseModule[]
  ExamQuestions ExamQuestion[]
  Enrollments   CourseEnrollment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([prerequisiteId])
  @@index([categoryId])
}

model CourseCategory {
  id          String   @id
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  Tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  Parent      CourseCategory?            @relation("CourseCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  Children    CourseCategory[]           @relation("CourseCategoryTree")
  Courses     Course[]
  Enrollments CourseCategoryEnrollment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
}

model CourseModule {
  id                String   @id
  tenantId          String
  courseId          String
  title             String
  sortOrder         Int      @default(0)
  /// Optional single checkpoint question gating entry into the next module.
  /// checkCorrectIndex is never sent to members before they submit, same as ExamQuestion.
  checkQuestion     String?
  checkOptions      String[] @default([])
  checkCorrectIndex Int?

  Course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Lessons CourseLesson[]

  @@index([courseId])
}

model CourseLesson {
  id        String  @id
  tenantId  String
  moduleId  String
  title     String
  duration  String
  videoUrl  String?
  sortOrder Int     @default(0)

  Module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

/// Options + correctIndex are never sent to members before they submit — the
/// backend grades exams server-side so the correct answer can't be read off the wire.
model ExamQuestion {
  id           String   @id
  tenantId     String
  courseId     String
  question     String
  options      String[]
  correctIndex Int
  sortOrder    Int      @default(0)

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseEnrollment {
  id               String    @id
  tenantId         String
  courseId         String
  memberId         String
  enrolledAt       DateTime  @default(now())
  completed        Boolean   @default(false)
  completedAt      DateTime?
  lastScorePct     Int?
  attempts         Int       @default(0)
  /// CourseLesson ids the member has watched to completion (YouTube "ended" event).
  watchedLessonIds String[]  @default([])
  /// CourseModule ids whose checkpoint question has been answered correctly.
  passedModuleIds  String[]  @default([])

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
  @@index([tenantId])
  @@index([memberId])
}

/// A member's one-time enrollment into a course CATEGORY — the reason/commitment/
/// agreement they submit gates access to every course directly in that category
/// (see CourseEnrollmentService.enroll, which checks for this row before allowing
/// the underlying per-course CourseEnrollment).
model CourseCategoryEnrollment {
  id                  String   @id
  tenantId            String
  categoryId          String
  memberId            String
  reason              String
  commitmentConfirmed Boolean  @default(false)
  agreedToRules       Boolean  @default(false)
  enrolledAt          DateTime @default(now())

  Category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([categoryId, memberId])
  @@index([tenantId])
  @@index([memberId])
}

model HomeCell {
  id          String   @id
  tenantId    String
  name        String
  leaderName  String
  leaderPhone String?
  meetingDay  String
  meetingTime String
  address     String
  state       String
  city        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, state, city])
}
