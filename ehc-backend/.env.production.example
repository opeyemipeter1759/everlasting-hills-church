# Backend production environment. Never commit real values.

# Runtime
NODE_ENV=production
PORT=4000

# PostgreSQL
# Use the transaction pooler at runtime and a direct connection for migrations.
DATABASE_URL=postgresql://USER:PASS@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://USER:PASS@HOST.pooler.supabase.com:5432/postgres

# Supabase auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Required by account provisioning/administration. Backend only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Tenant and public application URLs
DEFAULT_TENANT_ID=ehc_xxxxxxxxxxxxxxxxxxxx
FRONTEND_URL=https://everlastinghills.org
NEXT_PUBLIC_APP_URL=https://everlastinghills.org

# CMS signing. Required, independent, random, and at least 32 characters each.
# CMS_REVALIDATE_SECRET must match the server-only frontend value.
CMS_PREVIEW_SECRET=replace-with-an-independent-random-preview-secret
CMS_REVALIDATE_SECRET=replace-with-an-independent-random-revalidation-secret

# Optional bootstrap account. Prefer an invitation/reset flow; never commit it.
# DEFAULT_SUPER_ADMIN_EMAIL=admin@example.com
# DEFAULT_SUPER_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Email (optional)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=hello@everlastinghills.org
# RESEND_ADMIN_EMAIL=admin@everlastinghills.org
# CONTACT_EMAIL=contact@everlastinghills.org

# CORS and rate limits
# CORS_EXTRA_ORIGINS=https://staging.everlastinghills.org
CORS_ALLOW_VERCEL_PREVIEWS=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Background jobs (optional; absent uses in-process dispatch)
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Observability (optional)
# SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0

# Giving (optional)
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 uploads (optional; configure the complete set together)
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=ehc-assets
# R2_BUCKET_NAME is a deprecated alias; do not set both names.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://cdn.everlastinghills.org

# Web Push (optional; configure the complete set together)
# VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# VAPID_SUBJECT=mailto:admin@everlastinghills.org

# Attendance windows in West Africa Time (optional; defaults shown)
ATTENDANCE_SUNDAY_OPEN=08:30
ATTENDANCE_SUNDAY_CLOSE=13:00
ATTENDANCE_WEDNESDAY_OPEN=17:30
ATTENDANCE_WEDNESDAY_CLOSE=21:00
