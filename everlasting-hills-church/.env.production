# Public build-time values for the production build (Cloud Run Docker build).
#
# Next.js inlines every NEXT_PUBLIC_ variable into the browser bundle when it
# builds, so anything here is visible to every visitor. NEVER put a secret or
# server-only value in this file: those go in Cloud Run → Variables & Secrets.

# Public API origin, used by browser calls and public calendar/download links.
NEXT_PUBLIC_API_BASE_URL=https://ehc-backend-api-886498964135.europe-west1.run.app

# Canonical site URL (links, share images, the PWA).
NEXT_PUBLIC_APP_URL=https://www.everlastinghills.church

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://rlolpmzyyllapmtaqmcy.supabase.co

# YouTube channel (public). The YouTube API key is NOT kept here: Cloud Build
# passes it in as a build arg (see cloudbuild.yaml and the Dockerfile).
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCMRCCGuaxNT2KP9I25q8pbA

# NEXT_PUBLIC_VAPID_PUBLIC_KEY is deliberately unset: lib/pwa/push.ts fetches
# the Web Push public key from the API (/push/public-key) when it isn't set.
