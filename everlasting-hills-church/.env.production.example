# Frontend production environment. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle and are not secrets.

# Nest API. The BFF uses the server-only/internal origin.
API_BASE_URL=http://ehc-backend.internal:4000
# Legacy fallback and browser-visible public calendar/download links only.
NEXT_PUBLIC_API_BASE_URL=https://api.everlastinghills.org

# Canonical application URL
NEXT_PUBLIC_APP_URL=https://everlastinghills.org

# Supabase public verification values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only CMS revalidation signature. Must match the backend value and be
# independent from Supabase/JWT secrets. Use at least 32 random characters.
CMS_REVALIDATE_SECRET=replace-with-an-independent-random-revalidation-secret

# Web Push public key (optional; safe to expose by design)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key

# YouTube public data API integration (optional; browser-visible)
# NEXT_PUBLIC_YOUTUBE_API_KEY=replace-with-restricted-browser-key
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=replace-with-channel-id

# Telegram sermon archive (optional; server-only except channel name)
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=replace-with-api-hash
# TELEGRAM_SESSION=replace-with-session-string
# TELEGRAM_CHANNEL_USERNAME=Pastoropeyemipeter
# TELEGRAM_MAX_PAGES=300
# TELEGRAM_FETCH_CONCURRENCY=10
# TELEGRAM_MAX_DURATION_MS=25000

# Backend-only values intentionally do not belong here: DATABASE_URL,
# DIRECT_URL, SUPABASE_SERVICE_ROLE_KEY, DEFAULT_TENANT_ID, Resend/Paystack
# secrets, R2 access keys, VAPID_PRIVATE_KEY, and CMS_PREVIEW_SECRET.
